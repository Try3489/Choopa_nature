*{box-sizing:border-box}:root{--bg:#050505;--panel:#101010;--text:#f4f4f4;--muted:#aaa;--line:#292929}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--text);font-family:Arial,Helvetica,sans-serif}a{text-decoration:none;color:inherit}.topbar{position:sticky;top:0;z-index:20;height:72px;padding:0 5%;display:flex;align-items:center;gap:30px;background:rgba(5,5,5,.94);border-bottom:1px solid var(--line)}.brand{font-size:24px;font-weight:800;margin-right:auto}.brand span{font-weight:400}nav{display:flex;gap:22px;color:#bbb}nav a:hover{color:#fff}.actions{display:flex;gap:8px}.icon-btn,.outline-btn,.primary-btn,.secondary-btn,.chip{cursor:pointer}.icon-btn{background:#151515;color:#fff;border:1px solid var(--line);border-radius:10px;padding:10px 13px}.outline-btn{background:transparent;color:#fff;border:1px solid var(--line);border-radius:10px;padding:10px 16px}.primary-btn{display:inline-block;background:#fff;color:#000;border:0;border-radius:10px;padding:13px 20px;font-weight:700}.secondary-btn{display:inline-block;background:#111;color:#fff;border:1px solid #3a3a3a;border-radius:10px;padding:13px 20px}.hero{min-height:78vh;display:flex;align-items:center;padding:90px 8%;background:radial-gradient(circle at 75% 35%,#252525 0,#0c0c0c 30%,#050505 65%)}.hero-content{max-width:760px}.eyebrow{font-size:12px;letter-spacing:2px;color:#888;font-weight:700}h1{font-size:clamp(50px,8vw,96px);line-height:.95;letter-spacing:-5px;margin:20px 0}h1 span{color:#aaa}.hero-text{font-size:18px;line-height:1.7;color:#bbb;max-width:680px}.hero-buttons{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}.section{padding:90px 6%;max-width:1400px;margin:auto}.section-heading{display:flex;justify-content:space-between;align-items:end;gap:20px}h2{font-size:42px;letter-spacing:-2px;margin:10px 0 25px}.search{width:min(340px,100%);background:#101010;border:1px solid var(--line);color:#fff;border-radius:10px;padding:13px 15px}.chips{display:flex;gap:9px;flex-wrap:wrap;margin-bottom:30px}.chip{background:#111;color:#bbb;border:1px solid var(--line);border-radius:999px;padding:9px 15px}.chip.active,.chip:hover{background:#fff;color:#000}.gallery{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.card{background:var(--panel);border:1px solid var(--line);border-radius:16px;overflow:hidden}.photo{height:280px;background-size:cover;background-position:center}.card-info{padding:15px 16px;display:flex;justify-content:space-between;gap:10px}.title{font-weight:700}.meta{font-size:13px;color:#888;margin-top:5px}.price{font-weight:800}.buy{margin:0 16px 16px;width:calc(100% - 32px);padding:11px;border-radius:9px;border:1px solid #444;background:#fff;color:#000;font-weight:700;cursor:pointer}.seller{display:flex;align-items:center;justify-content:space-between;gap:30px;background:#101010;border:1px solid var(--line);border-radius:20px;margin-bottom:70px}.seller p{color:#aaa;line-height:1.6;max-width:650px}footer{border-top:1px solid var(--line);padding:35px 6%;display:flex;justify-content:space-between;color:#777}.modal{position:fixed;inset:0;z-index:50;background:rgba(0,0,0,.75);display:grid;place-items:center;padding:20px}.modal.hidden{display:none}.modal-card{position:relative;background:#111;border:1px solid #333;border-radius:18px;padding:30px;max-width:520px;width:100%}.close{position:absolute;right:14px;top:10px;background:none;border:0;color:#fff;font-size:30px}.form{display:grid;gap:12px}.form input{background:#080808;border:1px solid #333;color:#fff;padding:13px;border-radius:9px}@media(max-width:900px){nav{display:none}.gallery{grid-template-columns:repeat(2,1fr)}.section-heading{flex-direction:column;align-items:stretch}.seller{flex-direction:column;align-items:flex-start}}@media(max-width:600px){.topbar{padding:0 4%}.brand{font-size:20px}.hero{padding:70px 6%}h1{font-size:54px;letter-spacing:-3px}.gallery{grid-template-columns:1fr}.section{padding:65px 5%}h2{font-size:34px}footer{flex-direction:column;gap:12px}}

